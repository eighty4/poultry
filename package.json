{
  "name": "@eighty4/poultry",
  "version": "0.0.1",
  "type": "module",
  "author": "Adam McKee <adam.be.g84d@gmail.com>",
  "keywords": [
    "languages",
    "sampling",
    "testing",
    "GitHub"
  ],
  "description": "Language sampling from GitHub to local filesystem",
  "license": "BSD-2-Clause",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0"
    }
  },
  "bin": {
    "poultry": "lib_js/bin.js"
  },
  "exports": {
    ".": {
      "node": "./lib_js/api.js",
      "types": "./lib_types/api.d.ts",
      "default": "./lib/api.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:tsc",
    "build:tsc": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
    "fmt": "prettier --write .",
    "fmtcheck": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/*",
    "lib_js/*",
    "lib_types/*",
    "CHANGELOG.md"
  ]
}
